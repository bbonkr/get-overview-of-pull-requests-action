{
  "name": "get-overview-of-pull-requests-action",
  "version": "1.1.0",
  "description": "GitHub action which is getting overview of pull requests.",
  "main": "lib/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbonkr/get-overview-of-pull-requests-action.git"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest",
    "test:clear": "jest --clearCache",
    "all": "npm run format && npm run lint && npm run build && npm run package"
  },
  "keywords": [
    "actions",
    "github",
    "pull_request"
  ],
  "author": {
    "email": "dev@bbon.kr",
    "name": "Pon Cheol Ku (구본철)",
    "url": "https://bbon.kr"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@octokit/action": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.18.0",
    "@eslint/object-schema": "^2.1.4",
    "@octokit/plugin-rest-endpoint-methods": "^13.2.4",
    "@octokit/types": "^13.5.0",
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vercel/ncc": "^0.36.1",
    "dotenv": "^16.3.1",
    "eslint": "^8.53.0",
    "eslint-plugin-github": "^4.10.2",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.0.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.6.2"
  }
}
